# copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
# AWS credentials are NOT set here - use `aws configure` / `aws login` / env vars.
aws_region          = "ap-south-1"
environment         = "dev"
cluster_name        = "stockpilot-eks"
cluster_version     = "1.34"
vpc_cidr            = "10.30.0.0/16"
node_instance_types = ["t3.medium"]
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4
